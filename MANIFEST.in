# The source distribution should be enough to read the project and run its
# suite: the docs are part of the deliverable, and the tests are deliberately
# dependency-free so a reader can verify the claims without installing anything.
include README.md
include README.zh.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include LICENSE
include examples/config.json
include examples/demo.sh
recursive-include docs *.md
recursive-include tests *.py
